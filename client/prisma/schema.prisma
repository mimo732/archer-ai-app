// ARCHER AI - Jarvis-style assistant schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MemoryItem {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Headline {
  id        String   @id @default(cuid())
  title     String
  source    String
  url       String
  createdAt DateTime @default(now())
}

// A device running the ARCHER desktop (Electron/Windows) or mobile
// (Capacitor/Android) app — registered against this website brain.
model Device {
  id        String          @id // deviceId generated by the installed app
  name      String
  platform  String // windows | android | ios | web
  version   String          @default("")
  lastSeen  DateTime        @default(now())
  createdAt DateTime        @default(now())
  commands  DeviceCommand[]
}

// A command queued on the website for a linked device
// (e.g. "open youtube on my Windows PC").
model DeviceCommand {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action    String // open_app | open_url | search_web | play_youtube | notify | sys_info | ping
  payload   String   @default("{}") // JSON string
  status    String   @default("pending") // pending | done | failed
  result    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId, status])
}
