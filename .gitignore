scripts/apkbuild/app/res/mipmap-xhdpi/
scripts/apkbuild/app/res/mipmap-xxhdpi/
scripts/apkbuild/app/res/mipmap-xxxhdpi/
scripts/winbuild/*
!scripts/winbuild/build.sh

